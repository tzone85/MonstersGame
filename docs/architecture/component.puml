@startuml component
title MonstersGame — Component Diagram (2026-06-02)

skinparam componentStyle rectangle
skinparam shadowing false

package "main.js" {
  [Phaser.Game]
}

package "scenes/" {
  [BootScene]
  [TitleScene]
  [TutorialScene]
  [GameScene]
  [HUDScene]
  [LevelUpScene]
  [PauseScene]
  [GameOverScene]
  [ShopScene]
  [SettingsScene]
}

package "entities/" {
  [Player]
  [Enemy]
  [Projectile]
  [Gem]
}

package "systems/ (pure)" {
  [collision]
  [steering]
  [waveSpawner]
  [autoAttack]
  [xpCurve]
  [passives]
}

package "audio/" {
  [SynthEngine]
  [tracks]
  [sfx]
}

package "save/" {
  [schema]
  [storage]
  [unlocks]
}

[Phaser.Game] --> [BootScene]
[BootScene] --> [TitleScene]
[TitleScene] --> [GameScene]
[TitleScene] --> [TutorialScene]
[TitleScene] --> [ShopScene]
[TitleScene] --> [SettingsScene]
[GameScene] --> [HUDScene]
[GameScene] --> [LevelUpScene]
[GameScene] --> [PauseScene]
[GameScene] --> [GameOverScene]

[GameScene] ..> [Player]
[GameScene] ..> [Enemy]
[GameScene] ..> [Projectile]
[GameScene] ..> [Gem]

[Player]       ..> [steering]
[GameScene]    ..> [waveSpawner]
[GameScene]    ..> [autoAttack]
[GameScene]    ..> [xpCurve]
[LevelUpScene] ..> [passives]

[GameScene]   ..> [SynthEngine]
[TitleScene]  ..> [SynthEngine]
[SynthEngine] ..> [tracks]
[SynthEngine] ..> [sfx]

[BootScene]   ..> [storage]
[GameScene]   ..> [storage]
[ShopScene]   ..> [storage]
[ShopScene]   ..> [unlocks]
[storage]     ..> [schema]

@enduml
