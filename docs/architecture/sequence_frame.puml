@startuml sequence_frame
title Sequence — single animation frame

skinparam shadowing false

participant "RAF" as raf
participant "main\nframe()" as main
participant "Canvas\n2D ctx" as ctx
participant "Game" as game
participant "Player" as player
collections "Obstacles" as obs

raf -> main : tick
main -> ctx : clearRect(0,0,w,h)
main -> game : render(ctx)
game -> obs : draw(ctx) for each
game -> player : draw(ctx)
game -> player : update()
player -> player : angleToFrameY(atan2(dy, dx))
player -> player : velocityToward(dx, dy)
player -> obs : checkCircleCollision(this, o)
alt collision
  player -> player : resolveCollision(this, o, cr)
end
player --> game
game --> main
main -> raf : requestAnimationFrame(frame)
@enduml
